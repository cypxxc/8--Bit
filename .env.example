NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_USER_ID=
LINE_CHANNEL_SECRET=
LINE_BOT_USER_ID=
# Verified public shop information. Leave blank to direct visitors to LINE.
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_EMAIL=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_HOURS=
