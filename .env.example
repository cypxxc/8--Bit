# HTTPS production origin, e.g. your verified domain. Unset keeps indexing off.
SITE_URL=
# Set ONLY when your proxy overwrites this header with one client IP and blocks
# direct access to Next. Empty uses a shared limit; never trust arbitrary XFF.
TRUSTED_CLIENT_IP_HEADER=
